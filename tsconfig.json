{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": false
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts", "packages/**/*.ts"]
}
