[Unit]
Description=Investment Banking native Source inspection
[Service]
ExecStart=/usr/bin/python3 /opt/cells/investmentbanking/dev/source-runtime/services/office/supervisor.py
Environment=OFFICE_RENDERER_SOCKET=/opt/cells/investmentbanking/dev/office/socket/source-repair.sock
Environment=OFFICE_RENDERER_IMAGE=sha256:118fee89a47b09c23c778707860b82b97da7529c675451fe20df81e08c4da9cd
