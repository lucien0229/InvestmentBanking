{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-banking.local/ai/tasks/financial_semantic_extraction/output/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "schema_version", "task_definition", "scope_digest_echo", "results", "abstentions", "omissions"],
  "properties": {
    "status": {"enum": ["complete", "partial", "abstained"]},
    "schema_version": {"const": "1.0.0"},
    "task_definition": {"const": "financial_semantic_extraction"},
    "scope_digest_echo": {"type": "string"},
    "results": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/result"}},
    "abstentions": {"type": "array", "maxItems": 200, "items": {"$ref": "https://investment-banking.local/ai/common/1.0.0#/$defs/Abstention"}},
    "omissions": {"type": "array", "maxItems": 200, "items": {"$ref": "https://investment-banking.local/ai/common/1.0.0#/$defs/Omission"}}
  },
  "$defs": {
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_key", "origin", "payload", "evidence_links", "support_status", "conflicts", "uncertainty_flags", "limitations", "required_human_decision"],
      "properties": {
        "candidate_key": {"type": "string"}, "origin": {"const": "ai_generated"}, "payload": {"$ref": "#/$defs/payload"},
        "evidence_links": {"type": "array", "maxItems": 30, "items": {"$ref": "https://investment-banking.local/ai/common/1.0.0#/$defs/EvidenceLink"}}, "support_status": {"$ref": "https://investment-banking.local/ai/common/1.0.0#/$defs/SupportStatus"}, "conflicts": {"type": "array", "maxItems": 20, "items": {"$ref": "https://investment-banking.local/ai/common/1.0.0#/$defs/Conflict"}}, "uncertainty_flags": {"type": "array", "maxItems": 20, "items": {"type": "string"}}, "limitations": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "required_human_decision": {"anyOf": [{"$ref": "https://investment-banking.local/ai/common/1.0.0#/$defs/RequiredHumanDecision"}, {"type": "null"}]}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["proposition", "definition", "period", "unit", "currency", "sign", "precision", "value_text", "actual_forecast", "source_fragment_id", "source_locator", "qualification"],
      "properties": {
        "proposition": {"type": "string"}, "definition": {"type": "string"}, "period": {"type": "string"}, "unit": {"type": "string"}, "currency": {"type": "string"}, "sign": {"enum": ["positive", "negative", "not_applicable", "unknown"]}, "precision": {"type": "integer", "minimum": 0, "maximum": 12}, "value_text": {"type": ["string", "null"], "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"}, "actual_forecast": {"enum": ["actual", "forecast", "unknown"]}, "source_fragment_id": {"type": "string"}, "source_locator": {"type": "object"}, "qualification": {"type": ["string", "null"]}
      }
    }
  }
}
