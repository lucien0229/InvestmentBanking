{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-banking.local/ai/common/1.0.0",
  "$defs": {
    "EvidenceLink": {
      "type": "object", "additionalProperties": false,
      "required": ["fragment_id", "relationship", "proposition_scope", "qualification", "limitation"],
      "properties": {
        "fragment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "relationship": {"enum": ["supports", "challenges"]},
        "proposition_scope": {"type": "string", "minLength": 1, "maxLength": 500},
        "qualification": {"type": ["string", "null"], "maxLength": 500},
        "limitation": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "Conflict": {"type": "object", "additionalProperties": false, "required": ["conflict_key", "dimension", "competing_refs", "affected_scope", "unresolved_alternatives", "affected_uses"], "properties": {"conflict_key": {"type": "string"}, "dimension": {"enum": ["definition", "period", "unit", "currency", "sign", "value", "source_version", "scope", "meaning"]}, "competing_refs": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "affected_scope": {"type": "string", "minLength": 1}, "unresolved_alternatives": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "affected_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "SupportStatus": {"enum": ["supported", "challenged", "conflicted", "insufficient_support", "unresolved_locator", "coverage_incomplete", "rights_blocked", "out_of_scope", "not_applicable"]},
    "UncertaintyFlag": {"enum": ["evidence_missing", "evidence_conflicted", "definition_unclear", "period_unclear", "unit_or_currency_unclear", "coverage_incomplete", "locator_unresolved", "rights_blocked", "source_stale", "source_not_reliance_eligible", "deterministic_validity_missing", "outside_task_scope"]},
    "Limitation": {"type": "string", "minLength": 1, "maxLength": 500},
    "Abstention": {"type": "object", "additionalProperties": false, "required": ["abstention_key", "affected_scope", "reason_codes", "unsupported_propositions", "missing_inputs", "output_ceiling", "permitted_partial_scope", "smallest_recovery_action", "resume_condition"], "properties": {"abstention_key": {"type": "string", "minLength": 1, "maxLength": 160}, "affected_scope": {"type": "string", "minLength": 1, "maxLength": 500}, "reason_codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/UncertaintyFlag"}}, "unsupported_propositions": {"type": "array", "items": {"type": "string", "maxLength": 500}}, "missing_inputs": {"type": "array", "items": {"type": "string", "maxLength": 160}}, "output_ceiling": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 160}}}, "permitted_partial_scope": {"type": "array", "items": {"type": "string", "maxLength": 240}}, "smallest_recovery_action": {"type": "string", "minLength": 1, "maxLength": 500}, "resume_condition": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "Omission": {"type": "object", "additionalProperties": false, "required": ["omission_key", "affected_scope", "reason_code", "explanation", "recovery_action", "material"], "properties": {"omission_key": {"type": "string", "minLength": 1, "maxLength": 160}, "affected_scope": {"type": "string", "minLength": 1, "maxLength": 500}, "reason_code": {"enum": ["outside_task_scope", "not_applicable", "duplicate_of_candidate", "independently_invalid", "coverage_incomplete", "rights_blocked"]}, "explanation": {"type": "string", "minLength": 1, "maxLength": 500}, "recovery_action": {"type": ["string", "null"], "maxLength": 500}, "material": {"const": false}}},
    "RequiredHumanDecision": {"type": "object", "additionalProperties": false, "required": ["decision_type", "question", "exact_object_and_version_refs", "scope", "purpose", "audience", "alternatives", "evidence_refs", "deterministic_check_refs", "recommended_option", "conditions", "invalidation_triggers"], "properties": {"decision_type": {"type": "string", "minLength": 1, "maxLength": 160}, "question": {"type": "string", "minLength": 1, "maxLength": 500}, "exact_object_and_version_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}}, "scope": {"type": "string", "minLength": 1, "maxLength": 500}, "purpose": {"type": "string", "minLength": 1, "maxLength": 240}, "audience": {"type": "string", "minLength": 1, "maxLength": 240}, "alternatives": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["key", "effect"], "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 120}, "effect": {"type": "string", "minLength": 1, "maxLength": 500}}}}, "evidence_refs": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "deterministic_check_refs": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "recommended_option": {"type": "string", "minLength": 1, "maxLength": 120}, "conditions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "invalidation_triggers": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}}}
  }
}
